# ============================================================
#  Panda Print — backend
#  Скопируйте в .env и заполните. .env в git не коммитится.
# ============================================================

# --- Сервер ---
PORT=3000
NODE_ENV=production
# Слушаем только петлевой интерфейс: наружу приложение выставляет Nginx.
# Менять стоит только в контейнере, где 127.0.0.1 недоступен снаружи.
HOST=127.0.0.1
# debug — если нужно увидеть подробности выгрузки каталога.
LOG_LEVEL=info
# Домены фронтенда через запятую. Звёздочка запрещена.
# Кириллический домен можно писать как есть: приложение само приведёт его
# к punycode, в котором браузер присылает заголовок Origin
# (пандапринт.shop -> xn--80aalrwdiejw.shop).
CORS_ORIGINS=https://пандапринт.shop,https://www.пандапринт.shop

# --- Яндекс Маркет (Партнёрский API) ---
# partner.market.yandex.ru -> Модули API -> создать токен
YANDEX_API_KEY=ACMA:xxxxxxxxxxxx:xxxxxxxx
# ID кабинета (бизнеса)
YANDEX_BUSINESS_ID=000000000
# Необязательно. Пусто = определяется автоматически через GET /v2/campaigns.
# Заполнять только если в кабинете несколько магазинов и нужен конкретный.
YANDEX_CAMPAIGN_ID=
# Как часто обновлять кэш каталога (формат cron). По умолчанию раз в 20 минут.
CATALOG_REFRESH_CRON=*/20 * * * *
# true  — показывать только товары, опубликованные хотя бы в одном магазине
#         (такой товар реально можно купить, ссылка не ведёт на мёртвую карточку);
# false — показывать всё, что имеет цену и ненулевой остаток.
CATALOG_REQUIRE_PUBLISHED=true

# --- SMTP (Яндекс Почта) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
# Ящик, от имени которого уходит письмо. Он же попадает в поле From:
# Яндекс не даёт отправлять «от чужого имени» и отклонит несовпадение.
SMTP_USER=razrslip@yandex.ru
# ВАЖНО: пароль приложения из Яндекс ID, а НЕ пароль от аккаунта.
# id.yandex.ru -> Безопасность -> Пароли приложений -> Почта
SMTP_PASS=xxxxxxxxxxxxxxxx
# Куда падают заявки. Может совпадать с SMTP_USER: ящик просто пишет сам себе,
# отдельная почта для этого не нужна. Reply-To подставляется адрес клиента,
# поэтому отвечать можно прямо из входящих кнопкой «Ответить».
MAIL_TO=razrslip@yandex.ru
# Отображаемое имя отправителя.
MAIL_FROM_NAME=Panda Print — форма сайта

# --- Анти-спам ---
# Яндекс SmartCaptcha. Пусто = проверка выключена, работает только honeypot.
SMARTCAPTCHA_SERVER_KEY=
